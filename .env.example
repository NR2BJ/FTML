# FTML (Folder Tree Media Library) Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=
# 세 컨테이너에 같은 태그를 사용한다. 배포 재현/복구에는 전체 커밋 SHA 권장.
FTML_TAG=latest
MEDIA_PATH=/mnt/storage/video
FTML_PORT=7979
# 백엔드/Whisper 실행 계정은 1000:1000이다.
# 미디어는 읽기 전용으로 마운트한다. 자막과 캐시는 ftml_data에 저장한다.
# Debian에서 stat -c '%g %n' /dev/dri/* 로 확인한 실제 번호를 입력한다.
# renderD*의 GID와 card*의 GID이며, 사용자 기본 GID 1000과는 별개다.
RENDER_GID=992
VIDEO_GID=44
# 원음은 유지하고 Whisper의 긴 선행 무음만 보수적으로 보정한다.
WHISPER_SPEECH_BOUNDARIES=true
