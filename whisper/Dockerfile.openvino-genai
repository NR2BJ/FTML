# Intel GPU에서 Whisper/Qwen 인식, CPU에서 Qwen 단어 시각 정렬

FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv \
    intel-opencl-icd libze1 \
    libsndfile1 ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/
RUN pip3 install --break-system-packages --no-cache-dir torch==2.14.1 torchvision==0.29.1 --index-url https://download.pytorch.org/whl/cpu \
    && pip3 install --break-system-packages --no-cache-dir -r /app/requirements.txt

COPY server.py inference_runtime.py subtitle_processing.py qwen_pipeline.py speech_observer.py benchmark.py /app/
WORKDIR /app

ENV MODEL_ID=OpenVINO/whisper-large-v3-int8-ov
ENV DEVICE=GPU
ENV PORT=8178
ENV HOME=/home/ftml
ENV XDG_CACHE_HOME=/home/ftml/.cache
ENV HF_HOME=/models
ENV HF_HUB_CACHE=/models/hub
ENV NUMBA_CACHE_DIR=/home/ftml/.cache/numba
ENV PYTHONDONTWRITEBYTECODE=1

# /root 아래의 캐시는 일반 사용자가 접근할 수 없다.
RUN mkdir -p /models /home/ftml/.cache/numba \
  && chown -R 1000:1000 /models /home/ftml

USER 1000:1000

EXPOSE 8178

CMD ["python3", "server.py"]
